# Локальный запуск и scripts/setup_secrets.py: скопируйте в .env.
# Любой секрет можно задать значением (NAME=…) или путём к файлу (NAME_FILE=…).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# App Store Connect: либо JSON {"key_id", "issuer_id", "key_path"}, либо ASC_KEY_ID / ASC_ISSUER_ID / ASC_PRIVATE_KEY_FILE
ASC_CREDENTIALS_FILE=~/.vibeling-release/asc-analytics.json
GOOGLE_SERVICE_ACCOUNT_JSON_FILE=~/.vibeling-release/play-service-account.json
# Язык перевода отзывов Google Play
TRANSLATE_TO=ru
